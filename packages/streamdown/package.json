{
  "name": "@brucekit/streamdown-vue",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "styles.css",
    "README.md"
  ],
  "homepage": "https://streamdown.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brucewar/streamdown-vue.git",
    "directory": "packages/streamdown"
  },
  "scripts": {
    "build": "tsup",
    "postbuild": "node scripts/postbuild.js",
    "test": "vitest run",
    "test:ui": "vitest --ui run",
    "test:coverage": "vitest --coverage run",
    "bench": "vitest bench --run > results.txt",
    "bench:ui": "vitest bench --ui --run",
    "size": "node scripts/bundle-size.js"
  },
  "author": "Bruce Wong <brucewar@163.com>",
  "license": "Apache-2.0",
  "description": "VUE markdown, designed for AI-powered streaming.",
  "devDependencies": {
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/math": "^1.0.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/hast": "^3.0.4",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/coverage-v8": "^4.0.15",
    "@vitest/ui": "4.1.6",
    "@vue/test-utils": "^2.4.10",
    "esbuild": "^0.27.7",
    "jsdom": "^27.3.0",
    "rehype-katex": "^7.0.1",
    "rehype-parse": "^9.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^3.19.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15",
    "vue": "^3.5.13"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "hast-util-sanitize": "^5.0.2",
    "html-url-attributes": "^3.0.1",
    "marked": "^17.0.1",
    "mermaid": "^11.12.2",
    "rehype-harden": "^1.1.8",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remend": "^1.3.0",
    "tailwind-merge": "^3.4.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "unist-util-visit-parents": "^6.0.0"
  }
}
